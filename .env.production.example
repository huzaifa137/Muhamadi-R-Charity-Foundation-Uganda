# Copy to .env on the production server (never commit the real .env).
APP_NAME="Muhamadi R Charity Foundation Uganda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

BCRYPT_ROUNDS=12

# Production database (MySQL/MariaDB recommended; use a least-privileged account)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Real mail is REQUIRED for password-reset emails (the "log" mailer only writes to storage/logs).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
FOUNDATION_NOTIFICATION_EMAIL=

# Hosted Flutterwave payment link for the public Donate button (leave empty to hide it and fall back to the pledge form)
FLUTTERWAVE_PAY_LINK=https://flutterwave.com/pay/qrslug-993880-0zxql4pisalb
